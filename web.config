<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for the Rashet 3TR (Hesham) React + Vite Single Page Application.
  Hosted at: https://rashet-etr-hesham.growfet.com

  Requires the IIS "URL Rewrite" module:
  https://www.iis.net/downloads/microsoft/url-rewrite
-->
<configuration>
  <system.webServer>

    <!-- ================================================================
         SPA ROUTING
         Any request that is NOT an existing file and NOT an existing
         directory is rewritten to /index.html so client-side routing
         (React Router) can handle deep links like /dashboard.
         Real files (js, css, images, fonts, ...) are served directly
         because they fail the "IsFile"/"IsDirectory" conditions below.
    ================================================================ -->
    <rewrite>
      <rules>
        <rule name="React SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Skip if the requested path is a real file on disk. -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- Skip if the requested path is a real directory. -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- Never rewrite API calls; let them pass through to the backend. -->
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- ================================================================
         COMPRESSION
         Enable gzip for both static and dynamic responses to reduce
         payload size for JS/CSS/JSON/SVG assets.

         NOTE: The <httpCompression> section (which defines *which* MIME
         types get compressed) is NOT delegated to site-level web.config
         by default and would cause HTTP 500.19 (0x8007000d) if placed
         here. It must be configured in applicationHost.config at the
         server level. <urlCompression> below IS delegated and toggles
         compression on for this site using the server's MIME type list.
    ================================================================ -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- ================================================================
         MIME TYPES
         Ensure modern web asset types are served with correct headers.
         Remove-then-add avoids "duplicate entry" errors if IIS already
         defines the type at the server level.
    ================================================================ -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />

      <!-- Vite fingerprints asset filenames (e.g. index-a1b2c3.js), so hashed
           assets can be cached aggressively. index.html itself is never cached
           (handled by the location rule below) so new builds are picked up. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!-- ================================================================
         SECURITY HEADERS
    ================================================================ -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- Do not cache index.html: it points to the current build's hashed assets.
       DisableCache overrides the site-wide max-age above (emitting
       Cache-Control: no-cache) so browsers always re-fetch the entry point
       and pick up new builds immediately.
       NOTE: <location> must be a direct child of <configuration>, NOT nested
       inside <system.webServer>, or IIS returns HTTP 500.19 (0x8007000d). -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
